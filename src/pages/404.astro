---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import { site } from "@/data/site";
import { ctaLabel, contactAnchor } from "@/data/site";
---

<BaseLayout
  title={`Página não encontrada | ${site.brand.fullName}`}
  description="Página não encontrada."
>
  <Header />
  <main class="grid min-h-[60vh] place-items-center px-[7%] py-[100px] text-center">
    <div>
      <p class="eyebrow font-bold text-green">ERRO 404</p>
      <h1 class="text-[clamp(34px,4vw,54px)] leading-[1.12] tracking-[-2px]">
        Página não encontrada.
      </h1>
      <p class="text-muted">O endereço acessado não existe ou foi movido.</p>
      <a href="/" class="btn">Voltar ao início</a>
      <a href={contactAnchor} class="text-link ml-4">{ctaLabel}</a>
    </div>
  </main>
  <Footer />
</BaseLayout>
