---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import FloatingCTA from "@/components/layout/FloatingCTA.astro";
import HeroSection from "@/components/hero/HeroSection.astro";
import Ticker from "@/components/hero/Ticker.astro";
import AboutSection from "@/components/about/AboutSection.astro";
import PartnersSection from "@/components/partners/PartnersSection.astro";
import ServicesSection from "@/components/services/ServicesSection.astro";
import ReviewsSection from "@/components/reviews/ReviewsSection.astro";
import FaqSection from "@/components/faq/FaqSection.astro";
import ContactSection from "@/components/contact/ContactSection.astro";
import { site } from "@/data/site";
---

<BaseLayout
  title={`${site.brand.fullName} | Proteção para o seu ambiente`}
  description={site.meta.description}
>
  <Header />
  <main>
    <HeroSection />
    <Ticker />
    <AboutSection />
    <PartnersSection />
    <ServicesSection />
    <ReviewsSection />
    <FaqSection />
    <ContactSection />
  </main>
  <Footer />
  <FloatingCTA />
</BaseLayout>
