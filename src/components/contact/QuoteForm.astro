---
import { services } from "@/data/services";
import { site } from "@/data/site";
---

<div>
  <form
    data-quote-form
    class="rounded-lg bg-white p-[35px] text-ink max-md:p-[25px]"
    aria-labelledby="quote-title"
  >
    <h3 id="quote-title" class="m-0 mb-[25px] text-[25px]">Solicite seu orçamento</h3>

    <label class="mb-4 block text-sm font-semibold">
      Seu nome
      <input
        name="name"
        required
        autocomplete="name"
        placeholder="Como podemos chamar você?"
        class="mt-1.5 block w-full rounded-md border border-[#d4ded8] bg-[#f8faf9] px-3.5 py-3 text-base font-normal text-ink outline-offset-2 focus:outline-2 focus:outline-green"
      />
    </label>

    <div class="mb-4 grid grid-cols-2 gap-[15px] max-md:grid-cols-1 max-md:gap-0">
      <label class="block text-sm font-semibold max-md:mb-4">
        WhatsApp
        <input
          name="phone"
          type="tel"
          required
          autocomplete="tel"
          placeholder="DDD + número"
          class="mt-1.5 block w-full rounded-md border border-[#d4ded8] bg-[#f8faf9] px-3.5 py-3 text-base font-normal text-ink focus:outline-2 focus:outline-green"
        />
      </label>
      <label class="block text-sm font-semibold">
        Cidade
        <input
          name="city"
          required
          autocomplete="address-level2"
          placeholder="Cidade do atendimento"
          class="mt-1.5 block w-full rounded-md border border-[#d4ded8] bg-[#f8faf9] px-3.5 py-3 text-base font-normal text-ink focus:outline-2 focus:outline-green"
        />
      </label>
    </div>

    <label class="mb-4 block text-sm font-semibold">
      Serviço de interesse
      <select
        name="service"
        required
        class="mt-1.5 block w-full rounded-md border border-[#d4ded8] bg-[#f8faf9] px-3.5 py-3 text-base font-normal text-ink focus:outline-2 focus:outline-green"
      >
        <option value="" disabled selected>Escolha um serviço</option>
        {services.map((service) => <option value={service.title}>{service.title}</option>)}
      </select>
    </label>

    <label class="mb-4 block text-sm font-semibold">
      Sobre o local
      <textarea
        name="details"
        rows="3"
        required
        placeholder="Tipo de imóvel, tamanho e o que você precisa"
        class="mt-1.5 block w-full rounded-md border border-[#d4ded8] bg-[#f8faf9] px-3.5 py-3 text-base font-normal text-ink focus:outline-2 focus:outline-green"
      ></textarea>
    </label>

    <button type="submit" class="btn btn-full">Preparar solicitação</button>
    <p class="mb-0 mt-3 text-xs text-muted">
      Confira a mensagem antes de encaminhar para a equipe.
    </p>
  </form>

  <dialog
    data-quote-dialog
    aria-labelledby="dialog-title"
    class="w-[calc(100%-30px)] max-w-[570px] rounded-[10px] border-0 p-[35px] text-ink"
  >
    <button
      type="button"
      data-quote-close
      aria-label="Fechar"
      class="absolute top-[10px] right-[15px] cursor-pointer border-0 bg-transparent text-[28px] text-muted"
    >
      ×
    </button>
    <p class="eyebrow mb-[22px] font-bold text-green">SOLICITAÇÃO DE ORÇAMENTO</p>
    <h3 id="dialog-title" class="m-0 text-[28px]">Sua mensagem está pronta.</h3>
    <p class="mt-3 text-muted">
      Copie o texto ou envie direto pelo WhatsApp ({site.contact.whatsapp.replace(/^55/, "")}).
    </p>
    <textarea
      data-quote-message
      rows="10"
      readonly
      aria-label="Mensagem de orçamento"
      class="my-4 block w-full rounded-md border border-[#d4ded8] bg-[#f8faf9] px-3.5 py-3 text-base text-ink focus:outline-2 focus:outline-green"
    ></textarea>
    <div class="flex flex-wrap gap-3">
      <button type="button" data-quote-copy class="btn cursor-pointer">Copiar mensagem</button>
      <a data-quote-send href="#" target="_blank" rel="noopener" class="btn">Enviar no WhatsApp</a>
    </div>
    <p data-quote-status role="status" class="mb-0 mt-3 text-sm text-muted"></p>
  </dialog>
</div>
