---
/**
 * Logotipo oficial (PNG transparente, `src/assets/images/brand/logo.png`).
 * Todas as aparições da marca do site passam por este componente.
 */
import { Image } from "astro:assets";
import logo from "@/assets/images/brand/logo.png";
import { site } from "@/data/site";

interface Props {
  /** Largura em px — a proporção (≈3:1) é preservada. */
  width?: number;
  variant?: "default" | "light";
}

const { width = 190, variant = "default" } = Astro.props;
const height = Math.round(width / (2000 / 661));
---

<Image
  src={logo}
  alt={site.brand.logoAlt}
  width={2000}
  height={661}
  class="h-auto w-auto"
  style={`width:${width}px;height:${height}px`}
  loading={variant === "light" ? "eager" : "lazy"}
/>
