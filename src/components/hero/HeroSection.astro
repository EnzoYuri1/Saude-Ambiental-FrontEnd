---
import { Image } from "astro:assets";
import { site } from "@/data/site";
import { heroSlides } from "@/data/services";
import { ctaLabel, contactAnchor } from "@/data/site";
---

<section
  id="inicio"
  data-showcase
  data-interval="5000"
  aria-label={`${site.brand.fullName} e nossos serviços`}
  class="relative isolate flex min-h-[calc(100svh-130px)] flex-col justify-center overflow-hidden bg-navy text-white"
>
  <div class="absolute inset-0 -z-20" data-slides>
    {
      heroSlides.map((slide, i) => (
        <div
          class:list={["showcase-slide absolute inset-0", i === 0 && "is-active"]}
          data-slide
          data-name={slide.name}
        >
          <Image
            src={slide.image}
            alt=""
            width={1920}
            height={1280}
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : "auto"}
            class="showcase-photo absolute inset-0 h-full w-full object-cover"
          />
        </div>
      ))
    }
  </div>
  <div
    class="absolute inset-0 -z-10"
    aria-hidden="true"
    style="background:linear-gradient(180deg,rgba(4,18,25,.28),rgba(4,18,25,.5) 52%,rgba(4,18,25,.8))"
  >
  </div>

  <div
    class="mx-auto w-full max-w-[1100px] px-6 pt-[85px] pb-[60px] text-center max-md:pt-[65px] max-md:pb-[45px]"
  >
    <h1 class="m-0 text-shadow-[0_3px_25px_rgba(0,0,0,0.33)]">
      <span class="block text-[80px] leading-[1.05] font-extrabold max-md:text-[80px]"
        >{site.brand.short}</span
      >
      <span class="mt-3 block text-[30px] font-bold text-lime md:text-[46px]"
        >{site.brand.name}</span
      >
    </h1>
    <p class="mt-6 max-w-[280px] text-base text-white md:mx-auto md:mt-6 md:max-w-none md:text-lg">
      {site.brand.tagline}
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-[15px] max-md:mt-8 max-md:gap-3">
      <a href={contactAnchor} class="btn max-md:px-[18px] max-md:py-[13px] max-md:text-sm"
        >{ctaLabel}</a
      >
      <a href="#servicos" class="btn btn-outline max-md:px-[18px] max-md:py-[13px] max-md:text-sm"
        >Conheça os serviços</a
      >
    </div>
  </div>

  <div
    class="relative mx-auto flex w-[86%] items-end justify-between gap-6 border-t border-white/28 pt-6 pb-[30px] max-md:flex-col max-md:items-center max-md:gap-3 max-md:text-center max-md:pt-[18px] max-md:pb-[25px]"
  >
    <div>
      <span class="text-xs tracking-[1.5px] text-[#d4e4dc]">CONHEÇA NOSSAS SOLUÇÕES</span>
      <p data-label class="mt-1.5 text-xl leading-[1.3] font-bold text-white md:text-2xl">
        {heroSlides[0].name}
      </p>
    </div>
    <div class="flex items-center gap-5 max-md:gap-4">
      <div class="flex gap-1" aria-label="Escolher serviço em destaque">
        {
          heroSlides.map((slide, i) => (
            <button
              type="button"
              data-goto={i}
              aria-pressed={i === 0}
              aria-label={slide.name}
              class="grid h-[44px] w-[30px] cursor-pointer place-items-center border-0 bg-transparent p-0"
            >
              <span class="h-2 w-2 rounded-full bg-white/50 transition-shadow aria-pressed:bg-lime aria-pressed:shadow-[0_0_0_4px_rgba(196,239,140,0.19)]" />
            </button>
          ))
        }
      </div>
      <button
        type="button"
        data-pause
        data-pause-text="Pausar"
        data-play-text="Reproduzir"
        data-subject="imagens dos serviços"
        aria-pressed="false"
        class="min-h-[44px] cursor-pointer rounded-md border border-white/60 bg-[#071b2660] px-[15px] py-[9px] text-sm text-white"
      >
        Pausar
      </button>
    </div>
  </div>
</section>
